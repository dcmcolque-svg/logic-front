ARG NODE_VERSION=22

FROM node:${NODE_VERSION}-slim AS build

ARG BUILD_CONFIG

WORKDIR /build

COPY package*.json .

RUN npm ci --silent

COPY src ./src
COPY public ./public
COPY angular.json tsconfig*.json .postcssrc.json ./

RUN npm run build -- -c ${BUILD_CONFIG}

FROM i1pro/nginx:stable

COPY --from=build /build/dist/edge-frontend/browser /usr/share/nginx/html

RUN chown -R nginx:nginx /usr/share/nginx/html && chmod -R 500 /usr/share/nginx/html

USER nginx

CMD ["nginx", "-g", "daemon off;"]
EXPOSE 8080
